# Identity server configuration. Copy to .env and fill in. The server reads
# .env itself on every start (real environment variables win), so after
# editing it a plain `pm2 restart identity` is enough.
#
# Never commit .env. Generate secrets with: npm run gen-keys

# --- Server -----------------------------------------------------------------
NODE_ENV=production
# Production port is 50011 (80/443 belong to another service).
PORT=50011
# Interface to bind. 0.0.0.0 = reachable from outside.
HOST=0.0.0.0

# The issuer every app is configured with. Exact: scheme, host, port, and NO
# trailing slash. Changing it invalidates every token and session.
OIDC_ISSUER=https://pass-port.duckdns.org:50011

# TLS. When both are set Node serves HTTPS itself (nothing sits in front).
# Leave both empty for plain HTTP in local development. Renewed certificates
# are picked up automatically within 12 hours (or on restart).
SSL_CERT_PATH=/etc/letsencrypt/live/pass-port.duckdns.org/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/pass-port.duckdns.org/privkey.pem

# --- Keys (npm run gen-keys) -------------------------------------------------
# Private RS256 signing keys as a JWKS, on ONE line, single-quoted. The first
# key signs; any others are only published for verification (rotation).
# Required in production; in development a throwaway key is used if empty.
OIDC_JWKS=
# Comma-separated cookie signing keys, newest first (older ones still verify).
# Also derives the CSRF / code-hashing key. Required in production.
COOKIE_KEYS=

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/identity

# --- Clients ----------------------------------------------------------------
# Web clients are confidential (client_secret_basic or client_secret_post).
# A web client is only enabled when both its secret and redirect URI are set.
# Redirect and post-logout URIs accept a comma-separated list (e.g. to add a
# localhost URI for development). Matching is exact.

SPENDLOG_WEB_CLIENT_SECRET=
SPENDLOG_WEB_REDIRECT_URI=https://spend-log.duckdns.org:50002/api/auth/oidc/callback
SPENDLOG_POST_LOGOUT_URI=https://spend-log.duckdns.org:50002/

TRIPPIN_WEB_CLIENT_SECRET=
TRIPPIN_WEB_REDIRECT_URI=https://trip-pin.duckdns.org:50008/api/v1/auth/oidc/callback
TRIPPIN_POST_LOGOUT_URI=https://trip-pin.duckdns.org:50009/login

INFRAME_WEB_CLIENT_SECRET=
INFRAME_WEB_REDIRECT_URI=https://in-frame.duckdns.org:50010/api/auth/oidc/callback
INFRAME_POST_LOGOUT_URI=https://in-frame.duckdns.org:50010/login

# Mobile clients are public (no secret, PKCE required). Defaults shown; the
# scheme is the Android applicationId, except that "_" is not allowed in a
# URI scheme, so Trippin's com.itineraryplanner.itinerary_planner becomes
# com.itineraryplanner.itinerary-planner. Each mobile client also accepts
# its own <scheme>:/oauth2redirect and <scheme>:/logout as post-logout URIs,
# plus that app's <APP>_POST_LOGOUT_URI above.
SPENDLOG_MOBILE_REDIRECT_URI=io.github.retxchintu.spendlog:/oauth2redirect
TRIPPIN_MOBILE_REDIRECT_URI=com.itineraryplanner.itinerary-planner:/oauth2redirect
INFRAME_MOBILE_REDIRECT_URI=app.inframe.android:/oauth2redirect

# Optional: APIs that want JWT (RS256) access tokens. A client that sends
# resource=<one of these> gets a JWT access token with that audience instead
# of the default opaque one. Comma-separated. Empty = opaque tokens only.
API_RESOURCES=

# --- Google sign-in (optional; the button is hidden when unset) -----------------
# Authorized redirect URI in Google Cloud Console:
#   https://pass-port.duckdns.org:50011/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (verification codes, reset links) ---------------------------------
# With SMTP_HOST empty, emails are printed to the console/PM2 log instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SpendLog, Trippin & InFrame <no-reply@example.com>"
