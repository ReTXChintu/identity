{
  "name": "identity",
  "version": "0.1.0",
  "private": true,
  "description": "First-party OpenID Connect identity server for SpendLog, Trippin and InFrame",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen-keys": "node scripts/gen-keys.mjs",
    "user": "node dist/cli.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.7",
    "oidc-provider": "^9.12.2",
    "openid-client": "^6.8.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "^9.12.1",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true
  }
}
